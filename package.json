{"name":"royal-pearl-valley","version":"1.0.0","private":true,"scripts":{"dev":"node -e \"const http=require('http'),fs=require('fs'),path=require('path');const root=process.cwd(),types={'.html':'text/html','.png':'image/png','.mp4':'video/mp4','.mov':'video/quicktime','.jpg':'image/jpeg'};http.createServer((req,res)=>{let p=decodeURIComponent(req.url.split('?')[0]);if(p==='/'||p.endsWith('/'))p+='/index.html';const f=path.join(root,p.replace(/^\\//,''));if(!f.startsWith(root)){res.writeHead(403).end();return}fs.readFile(f,(e,d)=>{if(e){res.writeHead(404).end('Not found');return}res.writeHead(200,{'Content-Type':types[path.extname(f).toLowerCase()]||'application/octet-stream'});res.end(d)})}).listen(4173,'127.0.0.1',()=>console.log('Royal Pearl Valley preview: http://127.0.0.1:4173'))\""}}